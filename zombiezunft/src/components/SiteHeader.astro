---
---

<header class="site-header" data-header>
  <a class="brand" href="/" aria-label="Bedburger Zombiezunft – Startseite">
    Bedburger <b>Zombiezunft</b>
  </a>
  <a class="site-header__cta" href="#tickets">Tickets</a>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem var(--edge-hero);
    animation: header-in 0.9s ease 0.4s backwards;
  }

  /* Hintergrund als eigene Ebene, die nur per Opacity eingeblendet wird (keine Layout-/Filter-Animation) */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(7 11 20 / 0.92);
    border-bottom: 1px solid rgb(246 237 214 / 0.1);
    opacity: 0;
    transition: opacity 250ms ease;
    pointer-events: none;
  }

  .site-header[data-solid='true']::before {
    opacity: 1;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-cream);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-decoration: none;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.6);
  }

  .brand b {
    font-weight: 700;
    color: var(--color-gold);
  }

  .site-header__cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1.15rem;
    border: 1px solid rgb(230 195 106 / 0.8);
    color: var(--color-cream);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .site-header__cta:hover {
    background: var(--color-gold);
    color: var(--color-ink);
  }

  @keyframes header-in {
    from { opacity: 0; transform: translateY(-0.75rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 480px) {
    .brand { font-size: 0.72rem; letter-spacing: 0.18em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header { animation: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.setAttribute('data-solid', String(window.scrollY > 24));
    update();
    document.addEventListener('scroll', update, { passive: true });
  }
</script>
