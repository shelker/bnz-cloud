---
import { event } from '../config/event.ts';
---

<div class="sticky-cta" data-sticky-cta aria-hidden="true">
  <p class="sticky-cta__price">
    {
      event.earlyBite.active ? (
        <>
          <b>{event.earlyBite.price}</b> <span>{event.earlyBite.label} · {event.priceNote}</span>
        </>
      ) : (
        <>
          <b>{event.price}</b> <span>{event.priceNote}</span>
        </>
      )
    }
  </p>
  <a class="btn" href="#tickets" tabindex="-1">Tickets sichern</a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    z-index: 45;
    inset: auto 0 0 0;
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem max(0.75rem, env(safe-area-inset-bottom));
    background: rgb(7 11 20 / 0.97);
    border-top: 1px solid rgb(246 237 214 / 0.14);
    transform: translateY(110%);
    transition: transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .sticky-cta[data-visible='true'] {
    transform: none;
  }

  .sticky-cta__price {
    margin: 0;
    font-family: var(--font-display);
    line-height: 1.15;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: rgb(246 237 214 / 0.75);
  }

  .sticky-cta__price b {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-gold);
  }

  @media (max-width: 767px) {
    .sticky-cta { display: flex; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-cta { transition: none; }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const tickets = document.querySelector<HTMLElement>('#tickets');

  if (bar && hero && tickets) {
    let pastHero = false;
    let atTickets = false;
    const link = bar.querySelector('a');
    const update = () => {
      const show = pastHero && !atTickets;
      bar.dataset.visible = String(show);
      bar.setAttribute('aria-hidden', String(!show));
      link?.setAttribute('tabindex', show ? '0' : '-1');
    };
    // sichtbar, sobald die Kamerafahrt vorbei ist; weg, wenn der Shop im Bild ist
    new IntersectionObserver(([e]) => {
      pastHero = !e.isIntersecting && e.boundingClientRect.top < 0;
      update();
    }).observe(hero);
    new IntersectionObserver(([e]) => {
      atTickets = e.isIntersecting;
      update();
    }, { rootMargin: '0px 0px -25% 0px' }).observe(tickets);
  }
</script>
